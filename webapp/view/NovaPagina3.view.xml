<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="locadora.sap.projetolocadorafiori.controller.NovaPagina3">

    <Page title="MAGIC MUSIC | The Cure Fandom" titleAlignment="Center" class="fullScreenPage">
        <Toolbar>
            <ToolbarSpacer ></ToolbarSpacer>
            <Button icon="sap-icon://home" tooltip="Início" press="onNavBack" />
            <Button icon="sap-icon://action-settings" tooltip="Configurações" press="onConfig"/>
        </Toolbar>
        <content>
			<VBox class="vboxFull">
				<Image class="imageFull" src="https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/80efc762-df65-4cc6-87e1-af09004fa778/d99fhin-3e8d65c3-8637-45ca-8efb-62ba68c3f0b5.jpg/v1/fill/w_1024,h_576,q_75,strp/the_cure_logo_wallpaper_by_impedancer_d99fhin-fullview.jpg?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..9grbZhrnu-nAzqoJOwuATGn_tZi-hT-g-8JHQ3F1FnQ"/>
			</VBox>	
            <SplitContainer>
                <masterPages>
            
                <Page id="masterPage1" title="The Cure - Collection" titleAlignment="Center">
                    <List id="NoteList" 
                        mode="SingleSelectMaster" 
                        selectionChange="onAlbumSelected" 
                        items="{modeloLista>/data}" 
                        noDataText="Nenhuma nota encontrada">
                        <ObjectListItem
                            icon="{modeloLista>imagemAlbum}"
                            intro="{modeloLista>titulo}"
                            title="{modeloLista>titulo} - {modeloLista>ano}">
                        </ObjectListItem>
                    </List>
                </Page>

                </masterPages>
 
                <detailPages>
                    <Page id="DetalhesNotaPage" title="{modeloLista>titulo}" titleAlignment="Center">
                    </Page>
                </detailPages>
            </SplitContainer>
        </content>
    </Page>

</mvc:View>